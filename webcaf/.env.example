# Copy to the ignored webcaf/.env and supply your registered Internal Access
# credentials before starting WebCAF. Never commit secrets.
DEBUG=True
SECRET_KEY=change-me-for-local-development
DATABASE_URL=postgresql://webcaf:webcaf@localhost:54321/webcaf  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379/0

# GDS Internal Access is the default locally and in sandbox.
SSO_MODE=internal-access
INTERNAL_ACCESS_CLIENT_ID=
INTERNAL_ACCESS_CLIENT_SECRET=
# Leave blank locally. ECS uses its task role to fetch the JSON secret at this ARN.
INTERNAL_ACCESS_SECRET_ARN=
# AWS_REGION=eu-west-2
INTERNAL_ACCESS_AUTHORIZATION_ENDPOINT=https://sso.service.security.gov.uk/oauth2/authorization
INTERNAL_ACCESS_TOKEN_ENDPOINT=https://sso.service.security.gov.uk/oauth2/token
INTERNAL_ACCESS_USERINFO_ENDPOINT=https://sso.service.security.gov.uk/oauth2/userinfo
INTERNAL_ACCESS_JWKS_ENDPOINT=https://sso.service.security.gov.uk/.well-known/jwks.json
INTERNAL_ACCESS_LOGOUT_ENDPOINT=https://sso.service.security.gov.uk/sign-out
# IA returns to the registered client's app_url after logout.
# LOGOUT_REDIRECT_URL is used by generic OIDC alternatives, not IA.

# Inactive alternatives: make up_one_login or make up_dex for Docker.
# For the One Login simulator with Django on the host, explicitly set:
# SSO_MODE=one-login
# GOV_UK_ONE_LOGIN_CLIENT_ID=webcaf-local
# GOV_UK_ONE_LOGIN_PRIVATE_KEY_PATH=tests/fixtures/one-login-simulator-private-key.pem
# GOV_UK_ONE_LOGIN_OPENID_CONFIG_URL=http://localhost:3000/.well-known/openid-configuration
# GOV_UK_ONE_LOGIN_SCOPE="openid email"
# GOV_UK_ONE_LOGIN_ENVIRONMENT=integration
# Then run make up_one_login_simulator to start its dependencies.

# For DEX on the host, set SSO_MODE=local and start the DEX dependencies.
# For real One Login, supply registered client settings and a securely stored
# private key as documented in docs/GOV_UK_ONE_LOGIN.md.

# GOV.UK Notify
# Leave these blank unless testing Notify locally. Use a test API key locally so
# requests reach Notify without delivering email. Never commit an API key.
NOTIFY_API_KEY=
NOTIFY_TEST_TEMPLATE_ID=
NOTIFY_API_TIMEOUT_SECONDS=10

# Existing service-journey templates. Leave blank to disable each notification.
NOTIFY_OTP_TEMPLATE_ID=
NOTIFY_CONFIRMATION_TEMPLATE_ID=
NOTIFY_ASSESSOR_EMAIL_TEMPLATE_ID=
NOTIFY_REVIEW_FINALISED_TEMPLATE_ID=
NOTIFY_TIP_APPROVED_TEMPLATE_ID=
NOTIFY_TIP_REJECTED_TEMPLATE_ID=
NOTIFY_TIP_SUBMITTED_TEMPLATE_ID=

# Dedicated test credentials used only by the opt-in real API integration test.
NOTIFY_INTEGRATION_API_KEY=
NOTIFY_INTEGRATION_TEMPLATE_ID=
