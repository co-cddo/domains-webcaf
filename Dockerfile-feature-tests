# Playwright base image with all browser dependencies pre-installed; noble ships Python 3.12
FROM mcr.microsoft.com/playwright/python:v1.55.0-noble

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/bin/python3 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Install deps early for better caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache --all-groups

# Browsers matching the locked playwright package
RUN playwright install chromium --with-deps && playwright --version

# Copy the rest
COPY . .

CMD ["pytest", "-q"]
